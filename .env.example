# ---- Database ----
DATABASE_URL=postgres://analytics:analytics@localhost:5433/analytics

# ---- Admin dashboard (generate with: npm run hash-password) ----
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CRON_SECRET=

# ---- Consent ----
# opt-in   : nothing is collected until the visitor accepts (default; use where consent is required, e.g. EU/UK)
# opt-out  : anonymous analytics with notice; returning-visitor cookie only after acceptance; GPC honored
# disabled : no collection at all
ANALYTICS_CONSENT_MODE=opt-in
HONOR_GPC=true
VISITOR_ID_MAX_AGE_DAYS=180

# ---- Client IP ----
# socket          : use the TCP peer (requires `npm start` / server.mjs). Ignores all forwarded headers.
# trusted-proxies : read TRUSTED_PROXY_HEADER only when the TCP peer is in TRUSTED_PROXY_CIDRS
# vercel          : use Vercel's platform-set x-real-ip (only honored when VERCEL=1)
# Leave unset for auto: "vercel" when deployed on Vercel, otherwise "socket".
# IP_SOURCE=socket
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_HEADER=x-forwarded-for
# full | truncated (/24 IPv4, /48 IPv6)
IP_STORAGE=full

# ---- IP enrichment (server-side only) ----
# mock | ipinfo | ip-api | none. Without IP_LOOKUP_API_KEY, ipinfo/ip-api fall back to labelled mock data.
IP_LOOKUP_PROVIDER=mock
IP_LOOKUP_API_KEY=
IP_LOOKUP_TIMEOUT_MS=2000
IP_LOOKUP_CACHE_HOURS=24

# ---- Retention and limits ----
RETENTION_DAYS=30
RATE_LIMIT_EVENTS_PER_MINUTE=120
ALLOWED_QUERY_PARAMS=utm_source,utm_medium,utm_campaign,utm_term,utm_content,ref
RECORD_AUTOMATED_HITS=true

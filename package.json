{
  "name": "visitor-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "dev:next": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx scripts/migrate.ts",
    "retention": "tsx scripts/retention.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vercel-build": "tsx scripts/migrate.ts && next build"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "bowser": "^2.14.1",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
